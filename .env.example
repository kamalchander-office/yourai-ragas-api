# Copy to .env in the project root. Never commit .env.

# --- QA pipeline outputs (default: qa/results/) ---
# QA_RESULTS_DIR=qa/results

# --- API collector backend: mock | yourai | pwa ---
# pwa = QA PWA at app-qa.yourai.com (cookie auth + qa/session.json) — default
API_BACKEND=pwa

# Mock local server (main.py) — used when API_BACKEND=mock
API_BEARER_TOKEN=your-secret-bearer-token
MOCK_API_URL=http://127.0.0.1:8001

# --- YourAI PWA QA (API_BACKEND=pwa) — https://app-qa.yourai.com/chat ---
YOURAI_PWA_BASE_URL=https://app-qa.yourai.com

# Recommended: API login (login → ya_premfa → verify-mfa → cookies)
YOURAI_PWA_LOGIN_EMAIL=
YOURAI_PWA_LOGIN_PASSWORD=
YOURAI_PWA_OTP_BYPASS=999999

# Optional fallback: paste cookies from browser instead of login above
# YOURAI_PWA_YA_ACCESS=
# YOURAI_PWA_YA_REFRESH=
YOURAI_PWA_TIMEOUT_SECONDS=120
YOURAI_PWA_POLL_INTERVAL=2
YOURAI_PWA_POLL_MAX_ATTEMPTS=90
# Collector: fresh chat per test case (avoids slow multi-turn history); delay between cases
# Prefer run_full_pipeline.py → PWA_FRESH_CONVERSATION_PER_CASE, or client.py flags below.
# YOURAI_PWA_FRESH_CONVERSATION_PER_CASE=true
# YOURAI_PWA_COLLECT_SLEEP=2
# Retry transient QA errors (504/503/408) on API calls
# YOURAI_PWA_REQUEST_RETRIES=2

# --- YourAI dev M2M Chat API (API_BACKEND=yourai) ---
YOURAI_BASE_URL=https://ai-dev.yourai.com
YOURAI_CLIENT_ID=dev-client-id
YOURAI_CLIENT_SECRET=dev-client-secret
YOURAI_ORG_ID=62476452-b0fa-43f9-87cc-7839d6e504bd
YOURAI_USER_ID=476dfdf4-36b2-4717-ac86-5d96b1892761
YOURAI_CONVERSATION_ID=575272df-3427-43ce-a4d0-d8ffb2b97b5b
DEFAULT_RETRIEVAL_MODE=hybrid
YOURAI_TIMEOUT_SECONDS=60
YOURAI_MAX_RETRIES=3
YOURAI_RETRY_BACKOFF_SECONDS=1.0

# Local fixture documents for corpus-grounded generation (see documents/README.md)
# DOCUMENTS_DIR=documents
# GENERATE_MAX_DOCUMENT_CHARS=80000

# Which AI powers main.py + generate_cases.py + default RAGAs judge:
#   openai | gemini | openrouter
LLM_PROVIDER=openrouter

# Optional: RAGAs + DeepEval judge in run_eval.py (defaults to same as LLM_PROVIDER)
# JUDGE_PROVIDER=openrouter

# --- ChatGPT / OpenAI (when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini (when LLM_PROVIDER=gemini) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- OpenRouter (when LLM_PROVIDER=openrouter or JUDGE_PROVIDER=openrouter) ---
# https://openrouter.ai/keys — OpenAI-compatible API; good when Gemini quota is exhausted
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_MODEL=openai/gpt-4o-mini
# Lower max_tokens avoids OpenRouter 402 when account credits are low (default SDK ≈ 16384)
# OPENROUTER_MAX_TOKENS=4096
# Embeddings for RAGAs answer_similarity (OpenRouter model id; no "pick model" in UI)
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: run_eval.py — score only first N rows (saves judge quota)
# RUN_EVAL_MAX_CASES=5
